# arranque.dat - ajuste fino de la carga de cada juego.
#
# Una linea por juego: el nombre del set y pares clave=valor separados por
# espacios. La linea "defecto" vale para los juegos que no tengan la suya.
#
#   velocidad   a que velocidad corre el emulador mientras carga, en PORCENTAJE
#                 100 = normal        200 = el doble       1000 = diez veces
#                   0 = sin freno, lo mas rapido que la maquina pueda
#
#   segundos    cuanto dura eso: los segundos que la pantalla esta en negro
#               mientras el juego carga. Es EXACTO, no una estimacion.
#
# OJO CON LOS SEGUNDOS: son segundos DEL JUEGO, no de reloj. Acelerar no tapa
# mas carga, tapa la misma en menos espera. Con "segundos=10 velocidad=500" el
# juego avanza 10 segundos suyos y tu esperas unos 2.
#
# Y con segundos=0 no hay ventana de arranque, asi que la velocidad TAMPOCO se
# aplica: el ajuste entero queda desactivado.
#
#   indicador=1 muestra ">> CARGANDO AL 300%" en pantalla mientras la emulacion
#               va acelerada, para ver de un vistazo si el ajuste hace algo.
#               Apagado por defecto: en una cabina no pinta nada
#
#   video=N     SOLO para videos.sh: el segundo en el que empieza lo que
#               quieres grabar como video de muestra. 'segundos=' dice cuando
#               la placa esta lista, pero la demo llega despues: Contra arranca
#               a los 7 y su demo empieza a los 16. Se mide con
#               ./videos.sh --tira <juego>
#
#   videodura=N SOLO para videos.sh: cuanto dura ese video (por defecto 12 s)
#
# creditos.lua IGNORA esas dos: su parser guarda cualquier clave y solo consulta
# las suyas. Estan aqui para que un unico fichero describa cada juego.
#
#   negro=0     acelera igual pero NO tapa la pantalla. Es como se ve el efecto
#               de la velocidad mientras se ajusta un juego:
#                 tapper segundos=10 velocidad=500 negro=0
#               (medido: esos 10 s de juego tardan 14,9 s reales al 100% y 3,7
#               al 500%)
#
# Mientras la pantalla esta en negro, el boton de moneda esta cerrado: durante
# su test de arranque la placa TIRA las monedas, asi que dejar pulsar ahi seria
# cobrar por nada. Si un juego tarda mas de la cuenta, subele los segundos.
#
# Dos claves mas, para casos concretos:
#
#   nvram=0     el juego no guarda su NVRAM al salir. Es para los que arrancan
#               con los creditos de la sesion anterior (mwalk, tapper). Ojo:
#               tampoco conservaran las puntuaciones.
#
# CUANDO PONER nvram=0 Y CUANDO NO (revisado el 2026-09-05)
#
# La NVRAM de muchas placas guarda DOS cosas a la vez: los creditos y las
# puntuaciones. Apagarla quita los creditos viejos, pero tambien tira los
# puntajes. No hace falta elegir siempre, porque hay dos formas de conservar
# los puntajes:
#
#   1. El juego esta en hiscore.dat (el plugin 'hiscore' de MAME, 5856 juegos).
#      Entonces las puntuaciones se guardan aparte, en su .hi, y nvram=0 es
#      seguro: se van los creditos y los puntajes se quedan.
#
#   2. No esta en hiscore.dat, pero SI tiene direccion verificada en
#      creditos.dat. Entonces NO se pone nvram=0: el barrido de creditos.lua ya
#      pone el contador a 0 al arrancar, asi que la NVRAM se puede dejar
#      encendida y conserva las puntuaciones.
#
#   3. No esta en ninguno de los dos. Ahi si hay que elegir, y se pone nvram=0
#      (los puntajes se pierden). La salida es buscarle la direccion con
#      buscar_creditos.sh y pasar al caso 2.
#
# NUNCA a un juego de CPS3 (sfiii3): ahi la "NVRAM" son los 81 MB de la flash
# con el juego grabado desde el CD, y sin ella vuelve a pedir los ~70 minutos
# de reescritura.
#
# Y recuerda que nvram=0 evita GUARDAR, no CARGAR: si el fichero viejo ya tiene
# creditos, hay que borrar ~/.mame/nvram/<juego>/ una vez ademas del ajuste.
#
#   auto=1      en vez de usar los segundos tal cual, se alarga solo hasta
#               detectar que la placa esta lista. Solo funciona en los juegos
#               que estan en creditos.dat, porque la senal que se mira es su
#               contador de creditos. Apagado por defecto: el ajuste normal es
#               poner los segundos a mano.
#
# Para saber cuanto necesita un juego: lanzalo con GA_VERBOSO=1 y prueba a meter
# una moneda nada mas empezar. Si el juego no la coge, sube los segundos.
defecto velocidad=0 segundos=5
simpsons velocidad=0 segundos=11 video=16
tapper velocidad=0 segundos=3
# Estos arrancan con los creditos de la sesion anterior, guardados en su NVRAM.
# nvram=0 hace que no la guarden, asi que cada arranque es de fabrica. El
# precio: tampoco conservan las puntuaciones.
rbtapper velocidad=0 segundos=3
pacman segundos=5 velocidad=0 indicador=0
qbert segundos=1 velocidad=0
nrallyx segundos=13 velocidad=0 indicador=0 video=28
mappy segundos=13 video=38
digdug segundos=8
ncv2 segundos=6 velocidad=0
sf2 segundos=5 velocidad=0
# sfiii3n es el set SIN CD (30 ficheros SIMM, ~80 MB) y aqui no esta; el que
# hay es sfiii3, que arranca del CHD tras grabar la flash una vez.
sfiii3 segundos=25 velocidad=0
simpsons2p segundos=11 velocidad=0 video=16
mwalk segundos=0 nvram=0

# Dragon's Lair es un LASERDISC: el "juego" es video que se reproduce a su
# velocidad. Acelerar el emulador NO adelanta una carga, adelanta la PELICULA:
# se ve a camara rapida y, con el frameskip del arranque, a saltos.
#
# Ademas no esta en creditos.dat, asi que no se usaban los 5 s de 'defecto'
# sino GA_ARRANQUE_SIN, que son 900 frames = 15 SEGUNDOS de destrozo.
#
# segundos=0 apaga el arranque tapado entero. Es lo correcto para cualquier
# juego de laserdisc, y de paso se ve su intro, que es la gracia del juego.
dlair segundos=0
contra segundos=7 velocidad=0 video=16
defender velocidad=0
