[Unit]
Description=Portero del panel arcade (proxy a la cabina + Wake-on-LAN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajusta estos tres a tu enlace con la cabina (ver pi/README.md):
Environment=CABINA=10.55.0.2:8808
Environment=CABINA_MAC=
Environment=BROADCAST=10.55.0.255
Environment=PUERTO=8080
ExecStart=/usr/bin/python3 %h/attractplus/pi/portero.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
