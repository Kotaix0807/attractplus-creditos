// CRT-lite: scanlines y nada mas, para una GPU que no da para mas.
//
// crt-real modela el haz del tubo: varias muestras por pixel y un par de pow()
// de gamma. En la cabina -- GeForce 410M con nouveau, que la deja clavada a
// 270 MHz porque no sabe subirle el reloj -- eso deja los juegos al 16-25%.
//
// Aqui se usa hlsl/scanline, que YA VIENE COMPILADO con MAME y hace una cuenta
// por pixel, en UNA sola pasada: de screen a output, sin destinos intermedios.
// Cada pasada a pantalla completa son unos 6 MB de ida y vuelta a una memoria
// que va a 405 MHz, y se nota:
//
//   pasadas   kungfum   mappy
//     4        45%       66%
//     2        60%       83%
//     1        85%       96%
//
// Y no se ve peor que crt-real, al reves: 75,6% de modulacion entre filas
// contra 63,5%, y con mas brillo (109 contra 99). Lo que se pierde es el
// modelado del haz, que sobre un CRT de verdad ya lo pone el tubo.
//
// Para ajustarlo: "Scanline Amount" (0 = ninguna, 1 = a tope) y
// "Individual Scanline Scale" (el grosor de cada linea).
//
// OJO al tocarla: referenciar un "parameter" desde una pasada sin declararlo
// en el bloque "parameters" hace que MAME se caiga con un segfault y sin
// ningun mensaje.
{
	"name": "CRT-lite",
	"author": "Ryan Holtz, ImJezze (hlsl/scanline)",
	"sliders": [
		{ "type": "float", "name": "scanline_alpha",
		  "text": "Scanline Amount",            "default": 0.75,
		  "max": 1.0, "min": 0.0, "step": 0.05, "format": "%1.2f", "screen": "raster" },
		{ "type": "float", "name": "scanline_scale",
		  "text": "Overall Scanline Scale",     "default": 1.0,
		  "max": 4.0, "min": 0.0, "step": 0.05, "format": "%1.2f", "screen": "raster" },
		{ "type": "float", "name": "scanline_height",
		  "text": "Individual Scanline Scale",  "default": 1.0,
		  "max": 4.0, "min": 0.0, "step": 0.05, "format": "%1.2f", "screen": "raster" },
		{ "type": "float", "name": "scanline_variation",
		  "text": "Scanline Variation",         "default": 1.0,
		  "max": 4.0, "min": 0.0, "step": 0.05, "format": "%1.2f", "screen": "raster" },
		{ "type": "float", "name": "scanline_bright_scale",
		  "text": "Scanline Brightness Scale",  "default": 1.75,
		  "max": 4.0, "min": 0.0, "step": 0.05, "format": "%1.2f", "screen": "raster" },
		{ "type": "float", "name": "scanline_jitter_amount",
		  "text": "Scanline Jitter Amount",     "default": 0.0,
		  "max": 4.0, "min": 0.0, "step": 0.05, "format": "%1.2f", "screen": "raster" },
		{ "type": "float", "name": "scanline_bright_offset",
		  "text": "Scanline Brightness Offset", "default": 0.0,
		  "max": 4.0, "min": 0.0, "step": 0.05, "format": "%1.2f", "screen": "raster" }
	],
	"parameters": [
		{ "name": "jitter", "type": "frame", "period": 2 },
		{ "name": "time",   "type": "time",  "limit": 0.0 }
	],
	"targets": [],
	"passes": [
		{	"effect": "hlsl/scanline",
			"name": "Scanlines",
			"uniforms": [
				{ "uniform": "u_scanline_alpha",         "slider": "scanline_alpha" },
				{ "uniform": "u_scanline_scale",         "slider": "scanline_scale" },
				{ "uniform": "u_scanline_height",        "slider": "scanline_height" },
				{ "uniform": "u_scanline_variation",     "slider": "scanline_variation" },
				{ "uniform": "u_scanline_bright_scale",  "slider": "scanline_bright_scale" },
				{ "uniform": "u_scanline_bright_offset", "slider": "scanline_bright_offset" },
				{ "uniform": "u_scanline_jitter",        "slider": "scanline_jitter_amount" },
				{ "uniform": "u_jitter_amount",          "parameter": "jitter" },
				{ "uniform": "u_time",                   "parameter": "time" }
			],
			"input": [ { "sampler": "s_tex", "texture": "screen" } ],
			"output": "output"
		}
	]
}
