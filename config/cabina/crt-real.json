			"min": 0.0,
			"step": 0.05,
			"format": "%1.2f",
			"screen": "raster"
		},
		{
			"type": "float",
			"name": "aperture_brightboost",
			"text": "Shadow mask brightness boost",
			"default": 0.0,
			"max": 1.0,
			"min": 0.0,
			"step": 0.05,
			"format": "%1.2f",
			"screen": "raster"
		},
		{
			"type": "float",
			"name": "spot_size",
			"text": "Spot size minimum",
			"default": 0.16,
			"max": 0.5,
			"min": 0.1,
			"step": 0.01,
			"format": "%1.2f",
			"screen": "raster"
		},
		{
			"type": "float",
			"name": "spot_growth",
			"text": "Spot size dilation",
			"default": 0.08,
			"max": 0.4,
			"min": 0.0,
			"step": 0.01,
			"format": "%1.2f",
			"screen": "raster"
		},
		{
			"type": "float",
