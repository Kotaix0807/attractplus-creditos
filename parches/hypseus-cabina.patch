+// cabina: escribe "1" en el fichero de HYPSEUS_LISTO (temporal + rename, para
+// que quien lo lea nunca lo vea a medias). Sin la variable no hace nada.
+static void avisar_listo()
+{
+    const char *ruta = getenv("HYPSEUS_LISTO");
+    if (!ruta || !*ruta) return;
+    std::string tmp = std::string(ruta) + ".tmp";
+    FILE *f = fopen(tmp.c_str(), "w");
+    if (!f) { LOGW << "no puedo escribir " << tmp; return; }
+    fputs("1", f);
+    fclose(f);
+    if (rename(tmp.c_str(), ruta) != 0) LOGW << "no puedo renombrar a " << ruta;
+    else LOGI << "placa lista: avisado en " << ruta;
+}
