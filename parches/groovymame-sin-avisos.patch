diff --git a/src/frontend/mame/ui/info.cpp b/src/frontend/mame/ui/info.cpp
index 9d6510941eb..025f9f274b2 100644
--- a/src/frontend/mame/ui/info.cpp
+++ b/src/frontend/mame/ui/info.cpp
@@ -355,6 +355,18 @@ machine_static_info::machine_static_info(const ui_options &options, machine_conf
 				m_has_analog = true;
 		}
 	}
+
+	// GroovyMAME: suppress every emulation warning at the source, so the startup
+	// screens, the main menu entry, the status text and the status colours all
+	// report a clean system.  The machine filters read game_driver::flags
+	// directly, so working/mechanical/BIOS filtering is unaffected.
+	m_flags &= ~(MACHINE_ERRORS | MACHINE_WARNINGS | MACHINE_BTANB);
+	m_emulation_flags &= ~DEVICE_ERRORS;
+	m_unemulated_features = device_t::feature::NONE;
+	m_imperfect_features = device_t::feature::NONE;
+	m_has_nonworking_devices = false;
+	m_media_warnings = false;
+	m_severe_media_warnings = false;
 }
 
 
